# Copy this file to .env and fill in your own keys. Never commit .env.

# Claude API key from console.anthropic.com
ANTHROPIC_API_KEY=

# Alpaca paper trading keys from your Alpaca dashboard (Paper Trading section)
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# The code only ever calls https://paper-api.alpaca.markets.
# If this is set to anything else, every call is refused.
# APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Optional settings
# TRADEDOCS_MODEL=claude-opus-5-5
# TRADEDOCS_EFFORT=medium
# TRADEDOCS_SEARCH=hybrid
